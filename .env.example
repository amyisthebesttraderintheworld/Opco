# TON Blueprint network settings
# Example: use testnet for the Open Cooperation Experiment deployment.
NETWORK=testnet
TONCENTER_API_KEY=
TONRPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC

# Live round and token routing (set after minting or deployment)
ROUND_CONTRACT_ADDRESS=EQBXKvC_gYJLNGpp4i5X0D__QMHhIa-9183D8HjJoWXKKs-U
OPCO_JETTON_ADDRESS=
MOCK_USDT_ADDRESS=

# Cloudflare deployment auth (preferred over `wrangler login`)
# Copy this file to .env. Keep .env local and never commit it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=open-cooperation-experiment

# Wallet-backed deploy settings (required for live deployment)
# Keep the mnemonic quoted if it contains spaces.
WALLET_MNEMONIC=""
WALLET_VERSION=v4r2
WALLET_ID=
SUBWALLET_NUMBER=
WALLET_NETWORK_ID=-3

# Round bootstrap settings
ROUND_STAKE_TYPE=free
ROUND_STAKE_AMOUNT=0
ROUND_DURATION=3600
ROUND_REVEAL_DURATION=600
ROUND_ID=1
ROUND_STARTS_AT=

# Explicit opt-in for deploying testnet-only OPCO and mock USDT jettons.
MINT_TESTNET_JETTONS=false
